@page "/bed-management"
@using QHPFH_ConceptPrototype.Data
@using MudBlazor

<section class="page-shell-card bed-mgmt-page bm-overview-page" @onclick="CloseKpiInfo" @onkeydown="HandleKeydown" tabindex="0">
    <header class="bm-overview-header bm-overview-header-row">
        <h3>Bed Management</h3>
        <div class="bm-access-selector">
            <label>Access view</label>
            <select @bind="SelectedAccessView" @bind:after="OnAccessViewChanged">
                <option value="statewide">Statewide</option>
                <option value="qch-bed-manager">QCH Bed Manager</option>
            </select>
        </div>
    </header>

    @if (IsQchAccess)
    {
        <p class="bm-scope-context">QCH facility view — Queensland Children’s Hospital</p>
    }

    <section class="bm-filter-row bm-filter-row-compact">
        @if (!IsQchAccess)
        {
            <div class="bm-filter"><label>HHS</label><select @bind="SelectedHhs" @bind:after="OnHhsChanged">@foreach (var hhs in HhsOptions){<option value="@hhs">@hhs</option>}</select></div>
            <div class="bm-filter"><label>Facility</label><select @bind="SelectedFacility">@foreach (var facility in FacilityOptions){<option value="@facility">@facility</option>}</select></div>
        }
        <div class="bm-filter"><label>Ward</label><select @bind="SelectedWard">@foreach (var ward in WardOptions){<option value="@ward">@ward</option>}</select></div>
    </section>

    <section class="bm-overview-cards">
        @foreach (var kpi in Kpis)
        {
            <article class="bm-kpi-card @kpi.ColorClass">
                @if (kpi.ShowInfoIcon)
                {
                    <div class="bm-kpi-info-wrap" @onclick:stopPropagation="true">
                        <button type="button" class="bm-kpi-info-btn" aria-label="More information about @kpi.Title" @onclick="() => ToggleKpiInfo(kpi.Title)">i</button>
                        @if (OpenKpiInfoTitle == kpi.Title)
                        {
                            <div class="bm-kpi-info-popover" role="tooltip">@kpi.InfoText</div>
                        }
                    </div>
                }
                <div class="bm-kpi-top"><span class="bm-kpi-icon"><MudIcon Icon="@kpi.Icon" Size="Size.Small" /></span><p>@kpi.Title</p></div>
                <strong>@kpi.Value</strong>
                <small>@kpi.Subtitle</small>
            </article>
        }
    </section>

    @if (SelectedVersion == "V1")
    {
        <section class="bm-insight-grid">
            <article class="bm-insight-card critical"><h4>3 wards are over capacity</h4><p>@OverCapacityText</p><button type="button" class="bm-insight-action" @onclick='() => ApplyInsightFilter("over-capacity")'>View affected wards</button></article>
            <article class="bm-insight-card warning"><h4>Cleaning backlog impacting capacity</h4><p>@DelayedRiskText</p><button type="button" class="bm-insight-action" @onclick='() => ApplyInsightFilter("delayed-risk")'>View delayed discharge risk</button></article>
            <article class="bm-insight-card info"><h4>Elective surge expected tomorrow</h4><p>Elective admissions tomorrow are forecast to be 18% higher than today.</p><button type="button" class="bm-insight-action" @onclick="ClearInsightFilter">Clear filter</button></article>
            <article class="bm-insight-card staffing"><h4>Staffing impact</h4><p>12 wards have reduced capacity due to insufficient staffing.</p><button type="button" class="bm-insight-action" @onclick="ClearInsightFilter">Reset wards</button></article>
        </section>
    }

    @if (SelectedVersion == "V2")
    {
        <section class="bm-v2-ops-strip">
            <article><h4>Shift pressure</h4><strong>5 Critical Wards</strong><p>Immediate coordinator review required.</p></article>
            <article><h4>Staffing constraints</h4><strong>12 Wards impacted</strong><p>Roster shortfalls reducing open beds.</p></article>
            <article><h4>Discharge flow risk</h4><strong>78 Delayed patients</strong><p>Escalate discharge planning and transport.</p></article>
        </section>
    }

    <section class="bm-ward-table-wrap bm-overview-table-wrap">
        <div class="bm-table-toolbar">
            <div class="bm-view-row">
                @foreach (var view in new[] { "List", "Grid", "Compact" })
                {
                    <button class="bm-ghost view @(SelectedView == view ? "active" : null)" @onclick="() => SetView(view)">@view</button>
                }
            </div>
            <div class="bm-toolbar-actions">
                <button class="bm-ghost version @(SelectedVersion=="V1"?"active":null)" @onclick='() => SetVersion("V1")'>V1 Overview</button>
                <button class="bm-ghost version @(SelectedVersion=="V2"?"active":null)" @onclick='() => SetVersion("V2")'>V2 Operational</button>
                <button class="bm-ghost">Export</button><button class="bm-ghost">Update Capacity</button><button class="bm-ghost">Update Data</button>
            </div>
        </div>

        @if (SelectedView == "Grid")
        {
            <div class="bm-overview-gridcards @(SelectedVersion=="V2"?"v2":null)">
                @foreach (var row in PagedRows)
                {
                    <article class="bm-overview-gridcard">
                        <header><strong>@row.Hospital</strong><span>@row.Ward</span></header>
                        <p>@row.WardType</p><p>Physical @row.PhysicalBeds • Open @row.OpenBeds • Occupied @row.OccupiedBeds</p><p>Occupancy @row.Occupancy</p>
                        @if (SelectedVersion=="V2") { <p>Flow: Adm @(row.Elective + row.EdAddons + row.HithReturns) • Discharge @row.ActualDischarges</p> }
                        <div class="bm-grid-foot"><span class="bm-pressure-pill @row.PressureClass">@row.Pressure</span><span>@row.Constraints</span><span class="bm-action-icon-wrap"><img src="/QHPFH_ConceptPrototype/images/show.png" alt="View" class="bm-action-icon" /></span></div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="bm-responsive-table">
            <table class="bm-ward-table bm-overview-table @(SelectedView == "Compact" ? "compact" : null)">
                <thead>
                    @if (SelectedVersion == "V2" && SelectedView != "Compact")
                    {
                        <tr class="bm-group-head">
                            <th colspan="2">Ward</th><th colspan="2">Capacity</th><th colspan="2">Pressure</th><th colspan="2">Admissions & Flow</th><th colspan="2">Delayed / Staffing</th><th>Actions</th>
                        </tr>
                    }
                    <tr>
                        @foreach (var col in CurrentColumns)
                        {
                            <th @onclick="() => SortBy(col.Key)" class="@(SortColumn == col.Key ? "sorted" : null)">@col.Label @if (SortColumn == col.Key){<span>@(SortAsc ? "↑" : "↓")</span>}</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in PagedRows)
                    {
                        <tr>
                            @if (SelectedVersion=="V2" && SelectedView!="Compact")
                            {
                                <td>@row.Hospital</td><td>@row.Ward</td><td>@row.OpenBeds/@row.PhysicalBeds</td><td>@row.Occupancy</td><td><span class="bm-pressure-pill @row.PressureClass">@row.Pressure</span></td><td>@row.Constraints</td><td>@(row.Elective + row.EdAddons + row.HithReturns)</td><td>@row.ActualDischarges</td><td>@row.DelayedDischarge</td><td>@row.WardType</td><td><span class="bm-action-icon-wrap"><img src="/QHPFH_ConceptPrototype/images/show.png" alt="View" class="bm-action-icon" /></span><span class="bm-action-icon-wrap"><img src="/QHPFH_ConceptPrototype/images/edit.png" alt="Edit" class="bm-action-icon" /></span></td>
                            }
                            else if (SelectedView == "Compact")
                            {
                                <td>@row.Hospital</td><td>@row.Ward</td><td>@row.OpenBeds</td><td>@row.Occupancy</td><td><span class="bm-pressure-pill @row.PressureClass">@row.Pressure</span></td><td>@(row.Elective + row.EdAddons + row.HithReturns)</td><td>@row.ActualDischarges</td><td>@row.Constraints</td><td><span class="bm-action-icon-wrap"><img src="/QHPFH_ConceptPrototype/images/show.png" alt="View" class="bm-action-icon" /></span><span class="bm-action-icon-wrap"><img src="/QHPFH_ConceptPrototype/images/edit.png" alt="Edit" class="bm-action-icon" /></span></td>
                            }
                            else
                            {
                                <td>@row.Hospital</td><td>@row.Ward</td><td>@row.WardType</td><td>@row.PhysicalBeds</td><td>@row.OpenBeds</td><td>@row.OccupiedBeds</td><td>@row.Occupancy</td><td><span class="bm-pressure-pill @row.PressureClass">@row.Pressure</span></td><td>@row.Elective</td><td>@row.EdAddons</td><td>@row.HithReturns</td><td>@row.PredictedDischarges</td><td>@row.ActualDischarges</td><td>@row.DelayedDischarge</td><td>@row.Constraints</td><td><span class="bm-action-icon-wrap"><img src="/QHPFH_ConceptPrototype/images/show.png" alt="View" class="bm-action-icon" /></span><span class="bm-action-icon-wrap"><img src="/QHPFH_ConceptPrototype/images/edit.png" alt="Edit" class="bm-action-icon" /></span></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </section>
</section>

@code {
    private const string AccessStatewide = "statewide";
    private const string AccessQchBedManager = "qch-bed-manager";
    private const string QchHhs = "Children's Health Queensland";
    private const string QchFacility = "Queensland Children's Hospital";

    private string SelectedAccessView = AccessStatewide;
    private string SelectedHhs = DemoReferenceData.All;
    private string SelectedFacility = DemoReferenceData.All;
    private string SelectedWard = AllWards;
    private string ActiveInsightFilter = string.Empty;
    private string SelectedView = "List";
    private string SelectedVersion = "V1";
    private string SortColumn = "Hospital";
    private bool SortAsc = true;
    private int CurrentPage = 1;
    private int PageSize = 12;

    private const string AllWards = "All wards";
    private bool IsQchAccess => SelectedAccessView == AccessQchBedManager;
    private IReadOnlyList<string> HhsOptions => DemoReferenceData.HhsOptions;
    private IReadOnlyList<string> FacilityOptions => [DemoReferenceData.All, ..(SelectedHhs == DemoReferenceData.All ? DemoReferenceData.FacilitiesByHhs.SelectMany(x => x.Value).Distinct().Order() : DemoReferenceData.FacilitiesByHhs.GetValueOrDefault(SelectedHhs, []).Order())];
    private IReadOnlyList<string> WardOptions => GetAvailableWardOptions();
    private List<BedOverviewRow> FilteredRows => GetScopedBedManagementRows();
    private List<BedOverviewRow> SortedRows => SortAsc ? FilteredRows.OrderBy(GetSortValue).ToList() : FilteredRows.OrderByDescending(GetSortValue).ToList();
    private List<BedOverviewRow> PagedRows => SortedRows.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();

    private List<(string Key, string Label)> CurrentColumns => SelectedView == "Compact"
        ? [("Hospital", "Hospital"), ("Ward", "Ward"), ("OpenBeds", "Open Beds"), ("Occupancy", "Occupancy %"), ("Pressure", "Pressure"), ("Admissions", "Admissions"), ("Discharges", "Discharges"), ("Constraints", "Constraint"), ("Actions", "Actions")]
        : SelectedVersion == "V2"
        ? [("Hospital", "Hospital"), ("Ward", "Ward"), ("Capacity", "Capacity (Live)"), ("Occupancy", "Occupancy"), ("Pressure", "Pressure"), ("Constraints", "Pressure & Constraints"), ("Admissions", "Admissions & Flow"), ("Discharges", "Actual Discharges"), ("DelayedDischarge", "Delayed Discharge"), ("Staffing", "Staffing"), ("Actions", "Actions")]
        : [("Hospital", "Hospital"), ("Ward", "Ward"), ("WardType", "Ward Type"), ("PhysicalBeds", "Physical Beds"), ("OpenBeds", "Open Beds"), ("OccupiedBeds", "Occupied Beds"), ("Occupancy", "Occupancy %"), ("Pressure", "Pressure"), ("Elective", "Elective Admissions"), ("EdAddons", "ED Add-ons"), ("HithReturns", "HITH Returns"), ("PredictedDischarges", "Predicted Discharges"), ("ActualDischarges", "Actual Discharges"), ("DelayedDischarge", "Delayed Discharge"), ("Constraints", "Constraints / Reason"), ("Actions", "Actions")];

    private object GetSortValue(BedOverviewRow x) => SortColumn switch { "Ward" => x.Ward, "WardType" => x.WardType, "PhysicalBeds" => x.PhysicalBeds, "OpenBeds" => x.OpenBeds, "OccupiedBeds" => x.OccupiedBeds, "Occupancy" => x.OccupancyValue, "Pressure" => x.Pressure, "Elective" => x.Elective, "EdAddons" => x.EdAddons, "HithReturns" => x.HithReturns, "PredictedDischarges" => x.PredictedDischarges, "ActualDischarges" => x.ActualDischarges, "DelayedDischarge" => x.DelayedDischarge, _ => x.Hospital };
    private void SortBy(string key) { if (key is "Actions" or "Admissions" or "Discharges" or "Constraints" or "Capacity" or "Staffing") return; if (SortColumn == key) SortAsc = !SortAsc; else { SortColumn = key; SortAsc = true; } }
    private void SetView(string view) { SelectedView = view; CurrentPage = 1; }
    private void SetVersion(string version) => SelectedVersion = version;
    private string? OpenKpiInfoTitle;

    private void ToggleKpiInfo(string title)
    {
        OpenKpiInfoTitle = OpenKpiInfoTitle == title ? null : title;
    }

    private void CloseKpiInfo() => OpenKpiInfoTitle = null;

    private void HandleKeydown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") OpenKpiInfoTitle = null;
    }

    private string OverCapacityText => $"{Rows.Count(r => r.Pressure == "Critical")} wards are over occupied in the current scope.";
    private string DelayedRiskText => $"{Rows.Count(r => r.DelayedDischarge >= 4)} wards are showing delayed discharge risk.";

    private void OnAccessViewChanged()
    {
        ApplyAccessScope();
        ClearInsightFilter();
    }

    private void OnHhsChanged()
    {
        if (SelectedHhs != QchHhs && SelectedFacility == QchFacility)
        {
            SelectedFacility = DemoReferenceData.All;
        }
    }

    private void ApplyAccessScope()
    {
        if (IsQchAccess)
        {
            SelectedHhs = QchHhs;
            SelectedFacility = QchFacility;
            SelectedWard = AllWards;
        }
        else
        {
            SelectedHhs = DemoReferenceData.All;
            SelectedFacility = DemoReferenceData.All;
            SelectedWard = AllWards;
        }
    }

    private List<string> GetAvailableWardOptions()
    {
        var sourceRows = IsQchAccess
            ? Rows.Where(x => x.Hhs == QchHhs && x.Facility == QchFacility)
            : Rows.Where(x => SelectedFacility == DemoReferenceData.All || x.Facility == SelectedFacility);

        return [AllWards, .. sourceRows.Select(x => x.Ward).Distinct().Order()];
    }

    private List<BedOverviewRow> GetScopedBedManagementRows()
    {
        IEnumerable<BedOverviewRow> scoped = Rows;
        if (IsQchAccess)
        {
            scoped = scoped.Where(r => r.Hhs == QchHhs && r.Facility == QchFacility);
        }
        else
        {
            if (SelectedHhs != DemoReferenceData.All)
            {
                scoped = scoped.Where(r => r.Hhs == SelectedHhs);
            }
            if (SelectedFacility != DemoReferenceData.All)
            {
                scoped = scoped.Where(r => r.Facility == SelectedFacility);
            }
        }

        if (SelectedWard != AllWards)
        {
            scoped = scoped.Where(r => r.Ward == SelectedWard);
        }

        if (!string.IsNullOrWhiteSpace(ActiveInsightFilter))
        {
            scoped = ActiveInsightFilter switch
            {
                "over-capacity" => scoped.Where(r => r.Pressure == "Critical"),
                "delayed-risk" => scoped.Where(r => r.DelayedDischarge >= 4),
                _ => scoped
            };
        }

        return scoped.ToList();
    }

    private void ApplyInsightFilter(string filterKey) => ActiveInsightFilter = filterKey;
    private void ClearInsightFilter() => ActiveInsightFilter = string.Empty;


    private readonly List<KpiItem> Kpis =
    [
        new("Physical Capacity", "5,643", "Total beds", Icons.Material.Filled.Bed, "kpi-blue", "The count of physically placed beds in the selected ward, facility or view."),
        new("Open Operational Beds", "1,243", "22% of capacity", Icons.Material.Filled.KingBed, "kpi-green", "Beds that are open and available for use today. This may be lower than total physical beds due to staffing, maintenance, infection control, closures or operational constraints."),
        new("Beds Returning", "142", "Awaiting cleaning", Icons.Material.Filled.CleaningServices, "kpi-orange", "Beds waiting to be cleaned before they can return to available use."),
        new("Operational Pressure", "87%", "High", Icons.Material.Filled.Speed, "kpi-red", "The percentage of open operational beds currently occupied by patients."),
        new("Capacity Delta (24h)", "+53", "6 OUT 11 IN", Icons.Material.Filled.BarChart, "kpi-purple", "The change in available operational capacity compared with the previous reporting period."),
        new("Admissions Today", "245", "Planned: 182", Icons.Material.Filled.Groups, "kpi-teal", "Patients expected or confirmed for admission into the selected ward, facility or view today."),
        new("Delayed Flow Patients", "78", "12% of total", Icons.Material.Filled.PersonOff, "kpi-critical", "Patients who are medically ready or progressing toward discharge but remain in hospital due to outstanding discharge barriers.")
    ];
    private static readonly List<BedOverviewRow> Rows =
    [
        new("Metro North HHS", "Royal Brisbane and Women's Hospital", "General Medicine", "Medical", 42, 8, 34, "81%", "Medium", "medium", 4, 3, 1, 5, 3, 2, "Staffing gap"),
        new("Metro South HHS", "Logan Hospital", "ED", "Emergency", 24, 2, 22, "92%", "High", "high", 1, 6, 0, 3, 2, 1, "ED surge"),
        new("Wide Bay HHS", "Bundaberg Hospital", "General Medicine", "Medical", 30, 7, 23, "77%", "Low", "low", 2, 1, 1, 4, 3, 1, "Stable"),
        new("Mackay HHS", "Mackay Base Hospital", "Surgical", "Surgical", 55, 3, 52, "95%", "Critical", "critical", 7, 3, 2, 6, 4, 4, "Cleaning backlog"),
        new("Townsville HHS", "Townsville University Hospital", "General Medicine", "Medical", 60, 6, 54, "90%", "High", "high", 5, 2, 2, 8, 5, 3, "Delayed discharges"),
        new(QchHhs, QchFacility, "PICU", "Paediatric Intensive Care Unit", 36, 2, 34, "94%", "Critical", "critical", 3, 4, 1, 3, 1, 5, "Over capacity pressure"),
        new(QchHhs, QchFacility, "ED SSTA", "Emergency Department Short Stay Treatment Area", 18, 1, 17, "94%", "Critical", "critical", 1, 6, 0, 2, 1, 4, "ED flow backlog"),
        new(QchHhs, QchFacility, "12A", "Surgical & Orthopaedics", 28, 4, 24, "86%", "High", "high", 5, 2, 1, 5, 3, 3, "Elective surge"),
        new(QchHhs, QchFacility, "11A", "General Medicine", 24, 5, 19, "79%", "Medium", "medium", 3, 2, 1, 4, 3, 2, "Stable flow"),
        new(QchHhs, QchFacility, "11B", "Cardiology", 24, 2, 22, "92%", "High", "high", 2, 2, 1, 3, 2, 4, "Complex discharge"),
        new(QchHhs, QchFacility, "10A", "Respiratory", 24, 3, 21, "88%", "High", "high", 2, 3, 0, 4, 3, 3, "Respiratory season"),
        new(QchHhs, QchFacility, "10B", "Neurology", 24, 4, 20, "83%", "Medium", "medium", 2, 2, 0, 3, 2, 2, "Moderate demand"),
        new(QchHhs, QchFacility, "9A", "Oncology", 24, 2, 22, "92%", "High", "high", 4, 1, 0, 2, 1, 3, "Stepdown delayed"),
        new(QchHhs, QchFacility, "9B", "Rehabilitation / General Paediatrics", 24, 6, 18, "75%", "Low", "low", 1, 1, 0, 4, 3, 1, "Lower acuity"),
        new(QchHhs, QchFacility, "8A", "Specialist Paediatrics", 16, 2, 14, "88%", "High", "high", 1, 2, 0, 2, 1, 2, "Specialist wait"),
        new(QchHhs, QchFacility, "8BA", "Paediatric Care Area A", 11, 1, 10, "91%", "High", "high", 1, 1, 0, 2, 1, 2, "Capacity tight"),
        new(QchHhs, QchFacility, "8BC", "Paediatric Care Area C", 9, 1, 8, "89%", "High", "high", 0, 1, 0, 1, 1, 1, "Limited surge beds"),
        new(QchHhs, QchFacility, "5D", "Adolescent Ward", 24, 5, 19, "79%", "Medium", "medium", 2, 2, 0, 4, 3, 2, "Routine variation"),
        new(QchHhs, QchFacility, "4C", "Infant Medical Ward", 22, 2, 20, "91%", "High", "high", 2, 3, 0, 3, 2, 4, "Delayed family support"),
        new(QchHhs, QchFacility, "HITH", "Hospital in the Home", 0, 0, 0, "0%", "Low", "low", 6, 0, 8, 5, 6, 0, "Virtual capacity stream"),
        new(QchHhs, QchFacility, "Jacaranda Place", "Mental Health Unit", 12, 1, 11, "92%", "High", "high", 1, 1, 0, 2, 1, 3, "Length of stay pressure"),
        new(QchHhs, QchFacility, "Ellen Barron Centre", "Sleep Centre", 20, 4, 16, "80%", "Medium", "medium", 1, 1, 0, 3, 2, 1, "Planned throughput")
    ];
    private record KpiItem(string Title, string Value, string Subtitle, string Icon, string ColorClass, string InfoText, bool ShowInfoIcon = true);
    private record BedOverviewRow(string Hhs, string Facility, string Ward, string WardType, int PhysicalBeds, int OpenBeds, int OccupiedBeds, string Occupancy, string Pressure, string PressureClass, int Elective, int EdAddons, int HithReturns, int PredictedDischarges, int ActualDischarges, int DelayedDischarge, string Constraints)
    {
        public string Hospital => Facility;
        public int OccupancyValue => int.TryParse(Occupancy.Replace("%", string.Empty), out var value) ? value : 0;
    }
}
